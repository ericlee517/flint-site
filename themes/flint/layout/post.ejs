<article class="container mx-auto px-4 lg:px-75">
  <% if (page.cover) { %>
    <img src="<%= page.cover %>" alt="<%= page.title %>" class="w-full md:h-96 lg:h-96 object-cover mb-4" />
  <% } %>
  <h1 class="text-5xl mb-3 mt-10" style="font-weight: bold; word-wrap: break-word;">
    <%- page.title %>
  </h1>
  
  <div class="flex items-center gap-3 mb-4">
    <a href="/atom.xml" class="rss-subscribe-btn inline-flex items-center gap-2 px-5 py-3 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-full transition-colors" target="_blank">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
      </svg>
      <span>RSS 订阅</span>
    </a>
  </div>
  
  <div class="container">
    <p class="text-base-content/80" style="font-size: 1rem; word-wrap: break-word;">
      发表时间：<%- date(page.date, "YYYY-MM-DD") %> &nbsp;
      文章分类：<% if (page.categories && page.categories.length > 0) { %>
      <% page.categories.forEach(function(category) { %>
        <span class="badge badge-primary"><%= category.name %></span>
      <% }); %>
      <% } else { %>
      <span class="badge badge-primary">暂无分类</span>
      <% } %>
    </p>
    <br>
    <div class="post_img text-xl the-post-content">
      <%- page.content %>  
    </div>
  </div>
</article>
