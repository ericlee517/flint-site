<img src="<%= page.cover || '' %>" alt="<%= page.title || '' %>" class="w-full h-[70%] object-cover mt-20 contrast-70">
<div class="container mx-auto px-4 py-4 m-8 max-w-screen-xl flex-grow">
<h2 class="text-5xl text-bold mb-5"><%= page.title %></h2>
<p class="text-gray-500 text-2xl">特别编语</p>
<article class="mx-auto prose the-post-content">
    <%- page.content %>
</article>
<p class="text-gray-500">编者：<%= page.author %></p>
<p class="text-gray-500">最后更新于：<%= date(page.date, "YYYY年MM月DD日") %></p>
</div>