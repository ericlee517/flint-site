<div class="container mx-auto px-4 py-8 max-w-4xl">
    <img src="<%= page.cover || '' %>" alt="<%= page.title || '' %>" class="w-full max-w-2xl h-64 md:h-80 lg:h-96 object-cover rounded-lg shadow-lg mx-auto mb-8">
</div>
<div class="container mx-auto px-4 py-12 max-w-screen-xl flex-grow">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-bold mb-8 text-center"><%= page.title %></h1>
        <div class="relative mb-12">
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-px bg-gradient-to-r from-transparent via-base-300 to-transparent"></div>
            <div class="relative inline-block bg-base-100 px-6">
                <span class="text-base-content/60 text-lg sm:text-xl font-medium tracking-wide">特别编语</span>
            </div>
        </div>
        <article class="prose prose-lg max-w-none the-post-content">
            <%- page.content %>
        </article>
        <div class="mt-12 pt-8 border-t border-base-200/50">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-base-content/60 text-sm sm:text-base">
                <div class="flex items-center gap-2">
                    <span class="font-medium">编者：</span>
                    <span class="text-base-content/80"><%= page.author %></span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="font-medium">最后更新于：</span>
                    <span class="text-base-content/80"><%= date(page.date, "YYYY年MM月DD日") %></span>
                </div>
            </div>
        </div>
    </div>
</div>