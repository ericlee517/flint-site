<div class="container mx-auto px-4 m-8 max-w-screen-xl flex-grow">
    <h1 class="text-5xl mb-5 text-center">文章<br><small class="text-base-content/30">Articles</small></h1>
    <!-- name of each tab group should be unique -->
    <!-- 使用 flex 布局并结合 justify-center 类实现水平居中 -->
    <div class="flex justify-center mb-5">
        <div class="tabs tabs-box w-fit">
            <input type="radio" name="my_tabs_1" class="tab" aria-label="所有文章" checked="checked" data-category="all" />
            <% var allCategories = []; %>
            <% site.posts.each(function(post) { %>
                <% if (post.categories && post.categories.length > 0) { %>
                    <% post.categories.forEach(function(category) { %>
                        <% if (allCategories.indexOf(category.name) === -1) { %>
                            <% allCategories.push(category.name); %>
                            <input type="radio" name="my_tabs_1" class="tab" aria-label="<%= category.name %>" data-category="<%= category.name %>" />
                        <% } %>
                    <% }); %>
                <% } %>
            <% }); %>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-20 justify-center" id="posts-container">
        <% var postsPerPage = 8; %>
        <% var sortedPosts = site.posts.sort('-date').toArray(); %>
        <% sortedPosts.forEach(function(post, index) { %>
            <% var postCategories = post.categories.map(function(category) { return category.name; }); %>
            <% var pageNum = Math.floor(index / postsPerPage) + 1; %>
            <div class="card bg-base-100 shadow-lg" data-categories="<%= postCategories.join(' ') %>" data-page="<%= pageNum %>">
                <figure class="relative w-full h-48 overflow-hidden">
                    <img
                        data-src="<%= post.cover || '../image/post_cover.png' %>"
                        alt="<%= post.title %>"
                        class="w-full h-full object-cover lazyload" />
                </figure>
                <div class="card-body">
                    <h2 class="card-title text-2xl"><%= post.title %></h2>
                    <p><span class="badge badge-primary"><%- date(post.date, "YYYY-MM-DD") %></span> <% if (post.categories && post.categories.length > 0) { %><% post.categories.forEach(function(category) { %><span class="badge badge-outline"><%= category.name %></span><% }); %><% } else { %><span class="badge badge-outline badge-secondary">暂无分类</span><% } %></p>
                    <p><%= post.excerpt || post.description || '此文章还没有简介。' %></p>
                    <div class="card-actions justify-end">
                        <a href="../<%= post.path %>" target="_blank" class="btn btn-neutral">阅读</a>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
    <!-- 分页按钮 -->
    <div class="flex justify-center mt-8" id="pagination-container">
        <div class="join" id="pagination-buttons"></div>
    </div>
</div>
<script>
    const tabs = document.querySelectorAll('input[name="my_tabs_1"]');
    const allCards = document.querySelectorAll('.card');
    const paginationButtons = document.getElementById('pagination-buttons');
    const postsPerPage = 8;
    let currentCategory = 'all';
    let currentPage = 1;

    // 获取当前分类下的可见卡片
    function getVisibleCards() {
        return Array.from(allCards).filter(card => {
            const cardCategories = card.dataset.categories.split(' ');
            return currentCategory === 'all' || cardCategories.includes(currentCategory);
        });
    }

    // 渲染分页按钮
    function renderPagination() {
        const visibleCards = getVisibleCards();
        const totalPages = Math.ceil(visibleCards.length / postsPerPage) || 1;
        
        let html = '';
        // 上一页按钮
        html += `<button class="join-item btn ${currentPage === 1 ? 'btn-disabled' : ''}" onclick="goToPage(${currentPage - 1})">«</button>`;
        
        // 页码按钮
        for (let i = 1; i <= totalPages; i++) {
            html += `<button class="join-item btn ${currentPage === i ? 'btn-active' : ''}" onclick="goToPage(${i})">${i}</button>`;
        }
        
        // 下一页按钮
        html += `<button class="join-item btn ${currentPage === totalPages ? 'btn-disabled' : ''}" onclick="goToPage(${currentPage + 1})">»</button>`;
        
        paginationButtons.innerHTML = html;
    }

    // 显示当前页的内容
    function showCurrentPage() {
        const visibleCards = getVisibleCards();
        const totalPages = Math.ceil(visibleCards.length / postsPerPage) || 1;
        
        // 确保当前页在有效范围内
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;
        
        // 隐藏所有卡片
        allCards.forEach(card => card.style.display = 'none');
        
        // 显示当前页的卡片
        const startIndex = (currentPage - 1) * postsPerPage;
        const endIndex = startIndex + postsPerPage;
        const cardsToShow = visibleCards.slice(startIndex, endIndex);
        cardsToShow.forEach(card => card.style.display = 'block');
        
        renderPagination();
    }

    // 跳转到指定页
    function goToPage(page) {
        currentPage = page;
        showCurrentPage();
    }

    // 标签切换事件
    tabs.forEach(tab => {
        tab.addEventListener('change', function() {
            currentCategory = this.dataset.category;
            currentPage = 1; // 切换分类时重置到第一页
            showCurrentPage();
        });
    });

    // 初始化
    showCurrentPage();
</script>
