<footer class="bg-dark text-white py-12 mt-auto" role="contentinfo">
    <div class="container mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
            <div class="space-y-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center">
                        <img src="<%= theme.footer.brand.logo ? url_for(theme.footer.brand.logo) : url_for('image/logos/logo.png') %>" alt="" width="35px" height="35px" class="object-contain">
                    </div>
                    <span class="text-xl font-bold text-white"><%= theme.footer.brand.name || '涡轮火石' %></span>
                </div>
                <p class="text-gray-400 text-sm leading-relaxed"><%= theme.footer.brand.slogan || '每个宇宙都拥有无限可能' %></p>
            </div>

            <nav aria-labelledby="footer-more-heading">
                <h4 id="footer-more-heading" class="text-base font-semibold mb-4 text-white">更多相关</h4>
                <ul class="space-y-2.5" role="list">
                    <% if (theme.footer && theme.footer.links) { %>
                        <% theme.footer.links.forEach(item => { %>
                            <li>
                                <a href="<%= item.url %>"
                                   class="text-gray-400 hover:text-white text-sm transition-colors focus:outline-none focus:text-white">
                                    <%= item.title %>
                                </a>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
            </nav>

            <nav aria-labelledby="footer-docs-heading">
                <h4 id="footer-docs-heading" class="text-base font-semibold mb-4 text-white">产品文档</h4>
                <ul class="space-y-2.5" role="list">
                    <% if (theme.footer && theme.footer.document) { %>
                        <% theme.footer.document.forEach(item => { %>
                            <li>
                                <a href="<%= item.url %>"
                                   class="text-gray-400 hover:text-white text-sm transition-colors focus:outline-none focus:text-white">
                                    <%= item.title %>
                                </a>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
            </nav>

            <nav aria-labelledby="footer-contact-heading">
                <h4 id="footer-contact-heading" class="text-base font-semibold mb-4 text-white">联系我们</h4>
                <ul class="space-y-2.5" role="list">
                    <% if (theme.footer && theme.footer.contact) { %>
                        <% theme.footer.contact.forEach(item => { %>
                            <li>
                                <a href="<%= item.url %>"
                                   class="text-gray-400 hover:text-white text-sm transition-colors focus:outline-none focus:text-white">
                                    <%= item.title %>
                                </a>
                            <% }) %>
                        <% } %>
            </nav>
        </div>

        <div class="border-t border-gray-800 mt-10 pt-6">
            <p class="text-gray-400 text-sm text-center">
                Copyright © 2023 - <%= new Date().getFullYear() %> <%= theme.footer.copyright || '涡轮火石' %>. All rights reserved.
            </p>
            <div class="text-center mt-4">
                <a href="/atom.xml" 
                   class="inline-flex items-center justify-center text-base text-gray-400"
                   target="_blank"
                   rel="noopener"
                   aria-label="RSS 订阅">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 11a9 9 0 0 1 9 9"></path>
                        <path d="M4 4a16 16 0 0 1 16 16"></path>
                        <circle cx="5" cy="19" r="1"></circle>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>