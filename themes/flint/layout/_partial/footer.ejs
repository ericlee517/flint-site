<footer class="bg-dark text-white py-12">
    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-8 mb-8">
            <div>
                <div class="flex items-center space-x-3 mb-4">
                    <div class="w-10 h-10 bg-gradient-to-r from-primary to-accent rounded-lg flex items-center justify-center">
                        <img src="<%- url_for('image/logos/logo.png') %>" alt="logo" width="35px">
                    </div>
                    <span class="text-2xl font-bold gradient-text">涡轮火石</span>
                </div>
                <p class="text-gray-400 mb-4">每个宇宙都拥有无限可能</p>
                <div class="flex space-x-4">
                    <% if (theme.footer && theme.footer.contact) { %>
                        <% theme.footer.contact.forEach(item => { %>
                            <a href="<%= item.url %>" class="text-gray-400 hover:text-white transition-colors" title="<%= item.title %>">
                                <% if (item.title === 'GitHub') { %>
                                    <i class="fa fa-github text-xl"></i>
                                <% } else if (item.title === 'Email') { %>
                                    <i class="fa fa-envelope text-xl"></i>
                                <% } else if (item.title === '微信公众号') { %>
                                    <i class="fa fa-wechat text-xl"></i>
                                <% } else { %>
                                    <i class="fa fa-link text-xl"></i>
                                <% } %>
                            </a>
                        <% }) %>
                    <% } %>
                </div>
            </div>
            
            <div>
                <h4 class="text-lg font-bold mb-4">更多相关</h4>
                <ul class="space-y-2">
                    <% if (theme.footer && theme.footer.links) { %>
                        <% theme.footer.links.forEach(item => { %>
                            <li><a href="<%= item.url %>" class="text-gray-400 hover:text-white transition-colors"><%= item.title %></a></li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>
            
            <div>
                <h4 class="text-lg font-bold mb-4">产品文档</h4>
                <ul class="space-y-2">
                    <% if (theme.footer && theme.footer.document) { %>
                        <% theme.footer.document.forEach(item => { %>
                            <li><a href="<%= item.url %>" class="text-gray-400 hover:text-white transition-colors"><%= item.title %></a></li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>

            <div>
                <h4 class="text-lg font-bold mb-4">联系我们</h4>
                <ul class="space-y-2">
                    <% if (theme.footer && theme.footer.contact) { %>
                        <% theme.footer.contact.forEach(item => { %>
                            <li><a href="<%= item.url %>" class="text-gray-400 hover:text-white transition-colors"><%= item.title %></a></li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>
        </div>
        
        <div class="border-t border-gray-800 pt-8 text-center">
            <p class="text-gray-400">
                Copyright © 2023 - 2025 涡轮火石. All rights reserved.
            </p>
            <p class="text-gray-500 text-sm mt-2">
                每个宇宙 都拥有无限可能
            </p>
        </div>
    </div>
</footer>
