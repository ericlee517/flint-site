<!-- Hero Section -->
<div class="heros min-h-screen min-w-full flex items-center justify-center relative">
  <div class="glow-effect" id="floatingGlow"></div>
  <div class="hero-content text-center">
    <div class="max-w-5xl hero-text-introduce">
      <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-9xl font-bold hero-title leading-tight">
        <%- theme['turbo-hero'].title %>
      </h1>
      <p class="mt-6 sm:mt-8 text-sm sm:text-base md:text-xl lg:text-3xl hero-title leading-relaxed px-4 sm:px-0 font-light text-base-content/80">
        <%- theme['turbo-hero'].description %>
      </p>
    </div>
  </div>
</div>

<!-- Projects Section -->
<div id="projects" class="py-20 bg-base-100">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="text-center mb-12">
      <h2 class="text-4xl sm:text-5xl font-bold mb-4 mt-20">
    项目<br /><small class="text-base-content/60 text-lg sm:text-xl">Projects</small>
  </h2>
    </div>
    <!-- 大胆的不对称网格布局 -->
    <div class="<%= theme['project-card'].length <= 2 ? 'flex justify-center gap-12' : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8' %>">
      <% if (Array.isArray(theme['project-card'])) { %>
        <% theme['project-card'].forEach((project, index) => { %>
          <div class="group relative overflow-hidden bg-base-100 border border-base-100/30 hover:border-base-200/50 transition-all duration-700
                      <%= theme['project-card'].length <= 2 ? 'w-full max-w-xl' : '' %>
                      <%= theme['project-card'].length > 2 && index === 0 ? 'md:col-span-2' : '' %>">
            <div class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            <div class="relative h-full">
              <div class="aspect-[16/9] overflow-hidden">
                <% if (project.image) { %>
                  <img data-src="<%= project.image %>" alt="<%= project.title %>" class="lazyload w-full h-full object-cover" />
                <% } %>
              </div>
              <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
                <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2 group-hover:translate-y-0 translate-y-2 transition-transform duration-500">
                  <%= project['show-title'] ? project.title : '' %>
                </h2>
                <p class="text-white/80 text-sm sm:text-base mb-4 line-clamp-2 group-hover:opacity-100 opacity-0 transition-opacity duration-500">
                  <%= project.description || 'No description available.' %>
                </p>
                <div class="flex flex-col gap-3">      
                  <% if (project.url) { %>
                    <a class="px-4 py-2 bg-white text-black text-sm sm:text-base font-semibold rounded-full w-fit" href="<%= project.url %>">查看详情</a>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-center w-full text-base-content/60 col-span-full">暂无内容</p>
      <% } %>
    </div>
  </div>

<!-- 代表作 -->
<div id="products" class="py-20 bg-base-100">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="text-center mb-12">
      <h2 class="text-4xl sm:text-5xl font-bold mb-4 mt-20">
        产品<br /><small class="text-base-content/60 text-lg sm:text-xl">Products</small>
      </h2>
    </div>
    <!-- 大胆的瀑布流布局 -->
    <div class="<%= Array.isArray(theme['products']) && theme['products'].length <= 2 ? 'flex justify-center gap-12' : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8' %>">
      <% if (Array.isArray(theme['products'])) { %>
        <% theme['products'].forEach((product, index) => { %>
          <div class="group relative overflow-hidden bg-base-100 border border-base-100/30 hover:border-base-200/50 transition-all duration-700
                      <%= Array.isArray(theme['products']) && theme['products'].length <= 2 ? 'w-full max-w-xl' : '' %>">
            <div class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            <div class="relative h-full">
              <div class="aspect-[16/9] overflow-hidden">
                <% if (product.image) { %>
                  <img data-src="<%= product.image %>" alt="<%= product.title %>" class="lazyload w-full h-full object-cover" />
                <% } %>
              </div>
              <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
                <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2 group-hover:translate-y-0 translate-y-2 transition-transform duration-500">
                  <%= product.title %>
                </h2>
                <p class="text-white/80 text-sm sm:text-base mb-4 line-clamp-2 group-hover:opacity-100 opacity-0 transition-opacity duration-500"><%= product.description || '暂无简介' %></p>
                <div class="flex flex-col gap-3">
                  <% if (product.url) { %>
                    <a class="px-4 py-2 bg-white text-black text-sm sm:text-base font-semibold rounded-full w-fit" href="<%= product.url %>">立即查看</a>
                  <% } else { %>
                    <span class="px-4 py-2 bg-white/20 backdrop-blur-sm text-white text-sm sm:text-base rounded-full border border-white/30 w-fit">敬请期待</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-center w-full text-base-content/60 col-span-full">暂无内容</p>
      <% } %>
    </div>
  </div>
</div>

<!-- 音乐专辑 -->
<div class="container mx-auto px-4 py-20 text-center" id="albums">
  <h2 class="text-4xl sm:text-5xl font-bold mb-4 mt-20">
    音乐专辑<br /><small class="text-base-content/60 text-lg sm:text-xl">Music Albums</small>
  </h2>
  <div class="<%= theme['albums'].length <= 2 ? 'flex justify-center gap-12' : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6' %>">
    <% if (Array.isArray(theme['albums'])) { %>
      <% theme['albums'].forEach((album, index) => { %>
        <div class="group relative overflow-hidden bg-base-100 border border-base-100/30 hover:border-base-200/50 transition-all duration-700
                    <%= theme['albums'].length <= 2 ? 'w-full max-w-sm' : '' %>
                    <%= theme['albums'].length > 2 && index === 0 ? 'md:col-span-2 md:row-span-2' : '' %>">
          <div class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          <div class="relative h-full">
            <div class="aspect-square overflow-hidden">
              <% if (album.image) { %>
                <img data-src="<%= album.image %>" alt="<%= album.title %> - 专辑封面" class="lazyload w-full h-full object-cover" />
              <% } %>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
              <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2 group-hover:translate-y-0 translate-y-2 transition-transform duration-500">
                <%= album['show-title'] ? album.title : '' %>
              </h2>
              <p class="text-white/80 mb-4 text-sm sm:text-base line-clamp-2 group-hover:opacity-100 opacity-0 transition-opacity duration-500"><%= album.description || '暂无简介' %></p>
              <div class="flex items-center gap-3">
                <% if (album.url) { %>
                  <a class="px-4 py-2 bg-white text-black text-sm sm:text-base font-semibold rounded-full" href="<%= album.url %>">立即收听</a>
                <% } else { %>
                  <span class="px-4 py-2 bg-white/20 backdrop-blur-sm text-white text-sm sm:text-base rounded-full border border-white/30">敬请期待</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center w-full text-base-content/60 col-span-full">暂无内容</p>
    <% } %>
  </div>
</div>

<!-- 短片 -->
<div class="container mx-auto px-4 py-20 text-center" id="short-videos">
  <h2 class="text-4xl sm:text-5xl font-bold mb-4 mt-20">
    短片<br /><small class="text-base-content/60 text-lg sm:text-xl">Short Videos</small>
  </h2>
  <!-- 大胆的视频布局 -->
  <div class="<%= theme['short-videos'].length <= 2 ? 'flex justify-center gap-12' : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8' %>">
    <% if (Array.isArray(theme['short-videos']) && theme['short-videos'].length) { %>
      <% theme['short-videos'].forEach((video, index) => { %>
        <div class="group relative overflow-hidden bg-base-100 border border-base-100/30 hover:border-base-200/50 transition-all duration-700
                    <%= theme['short-videos'].length <= 2 ? 'w-full max-w-xl' : '' %>
                    <%= theme['short-videos'].length > 2 && index === 0 ? 'md:col-span-2' : '' %>">
          <div class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          <div class="relative h-full">
            <div class="aspect-video overflow-hidden">
              <% if (video.image) { %>
                <img data-src="<%= video.image %>" alt="<%= video.title %> 封面" class="lazyload w-full h-full object-cover" />
              <% } %>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
              <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2 group-hover:translate-y-0 translate-y-2 transition-transform duration-500">
                <%= video['show-title'] ? video.title : '' %>
              </h2>
              <p class="text-white/80 mb-4 text-sm sm:text-base line-clamp-2 group-hover:opacity-100 opacity-0 transition-opacity duration-500"><%= video.description || '暂无简介' %></p>
              <div class="flex items-center gap-3 flex-wrap">
                <% if (video.type === 'preview') { %>
                  <span class="px-4 py-2 bg-white/20 backdrop-blur-sm text-white text-sm sm:text-base rounded-full border border-white/30">即将上线</span>
                <% } else if (video.url) { %>
                  <a class="px-4 py-2 bg-white text-black text-sm sm:text-base font-semibold rounded-full" href="<%= video.url %>">立即观看</a>
                <% } %>
                <% if (video.projecturl) { %>
                  <a class="px-4 py-2 bg-white/20 backdrop-blur-sm text-white text-sm sm:text-base rounded-full border border-white/30 hover:bg-white/30 transition-colors duration-300" href="<%= video.projecturl %>">短片介绍</a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center w-full text-base-content/60 col-span-full">暂无短片。</p>
    <% } %>
  </div>
</div>

<!-- 团队成员 -->
<div class="container mx-auto px-4 py-20 text-center" id="team-members">
  <h2 class="text-4xl sm:text-5xl font-bold mb-4 mt-20">
    团队成员<br /><small class="text-base-content/60 text-lg sm:text-xl">Team Members</small>
  </h2>
  <!-- 大胆的团队成员布局 -->
  <div class="<%= theme['team-members'].length <= 2 ? 'flex justify-center gap-12' : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6' %>">
    <% if (Array.isArray(theme['team-members'])) { %>
      <% theme['team-members'].forEach((member, index) => { %>
        <div class="group relative overflow-hidden bg-base-100 border border-base-100/30 hover:border-base-200/50 transition-all duration-700
                    <%= theme['team-members'].length <= 2 ? 'w-full max-w-sm' : '' %>
                    <%= theme['team-members'].length > 2 && index === 0 ? 'md:col-span-2' : '' %>">
          <div class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
          <div class="relative h-full">
            <div class="aspect-square overflow-hidden">
              <% if (member.avatar) { %>
                <img data-src="<%= member.avatar %>" alt="<%= member.name %> - 团队成员" class="lazyload w-full h-full object-cover" />
              <% } %>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
              <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2 group-hover:translate-y-0 translate-y-2 transition-transform duration-500">
                <%= member.name %>
              </h2>
              <% if (member.position) { %>
                <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-xs sm:text-sm rounded-full border border-white/30 mb-3"><%= member.position %></span>
              <% } %>
              <p class="text-white/80 text-sm sm:text-base line-clamp-2 group-hover:opacity-100 opacity-0 transition-opacity duration-500"><%= member.description || '暂无简介' %></p>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center w-full text-base-content/60 col-span-full">暂无团队成员。</p>
    <% } %>
  </div>
</div>
