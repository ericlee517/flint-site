<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<!-- Hero Section -->
<div class="heros min-h-screen min-w-full flex items-center justify-center relative">
  <div class="glow-effect" id="floatingGlow"></div>
  <div class="hero-content text-center">
    <div class="max-w-5xl hero-text-introduce">
      <h1 class="hero-title text-4xl sm:text-5xl md:text-7xl lg:text-9xl font-bold leading-tight" data-hero-item>
        <%- theme['turbo-hero'].title %>
      </h1>
      <p class="hero-desc mt-6 sm:mt-8 text-sm sm:text-base md:text-xl lg:text-3xl leading-relaxed px-4 sm:px-0 font-light text-base-content/80" data-hero-item>
        <%- theme['turbo-hero'].description %>
      </p>
    </div>
  </div>
</div>

<!-- Announcement Banner -->
<% if (theme.announcement && theme.announcement.enabled) { %>
<div class="fixed top-0 left-0 right-0 z-50 bg-black text-white py-3 px-4 flex items-center justify-center gap-4">
  <span class="text-sm sm:text-base font-medium"><%= theme.announcement.content %></span>
  <a href="<%= theme.announcement.link %>" class="text-sm sm:text-base font-semibold underline hover:text-gray-300 transition-colors">
    <%= theme.announcement['link-text'] %>
  </a>
</div>
<style>
  body {
    padding-top: 44px;
  }
</style>
<% } %>

<!-- Projects Section -->
<div id="projects" class="py-20 bg-base-100 animate-section">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="text-center mb-12">
      <h2 class="text-4xl sm:text-5xl font-bold mb-4 mt-20">
    项目<br /><small class="text-base-content/60 text-lg sm:text-xl">Projects</small>
  </h2>
    </div>
    <!-- 大胆的不对称网格布局 -->
    <div class="<%= theme['project-card'].length <= 2 ? 'flex justify-center gap-12' : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8' %>">
      <% if (Array.isArray(theme['project-card'])) { %>
        <% theme['project-card'].forEach((project, index) => { %>
          <div class="card-item relative overflow-hidden bg-base-100 border border-base-100/30 hover:border-base-200/50 transition-all duration-700
                      <%= theme['project-card'].length <= 2 ? 'w-full max-w-xl' : '' %>
                      <%= theme['project-card'].length > 2 && index === 0 ? 'md:col-span-2' : '' %>">
            <div class="relative h-full">
              <div class="aspect-[16/9] overflow-hidden">
                <% if (project.image) { %>
                  <img data-src="<%= project.image %>" alt="<%= project.title %>" class="lazyload w-full h-full object-cover" />
                <% } %>
              </div>
              <div class="absolute bottom-0 left-0 right-0 p-4 flex justify-center">
                <% if (project.url) { %>
                  <a class="px-6 py-2 bg-white/80 backdrop-blur-xl text-black text-sm sm:text-base font-medium rounded-full hover:bg-white/95 border border-white/50 transition-all duration-300" href="<%= project.url %>">查看详情</a>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-center w-full text-base-content/60 col-span-full">暂无内容</p>
      <% } %>
    </div>
  </div>

