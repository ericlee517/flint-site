<!-- Hero Section -->
<div class="heros min-h-screen min-w-full flex items-center justify-center relative">
  <div class="glow-effect" id="floatingGlow"></div>
  <div class="hero-content text-center">
    <div class="max-w-5xl hero-text-introduce">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-8xl font-bold hero-title leading-tight">
        每个宇宙<br />都拥有无限可能
      </h1>
      <p class="mt-6 sm:mt-8 text-sm sm:text-base md:text-xl lg:text-2xl hero-title leading-relaxed px-4 sm:px-0 font-light text-base-content/80">
        我们正在创造一个个<b class="gray-text">全新的</b> 富有创意的小说宇宙 每一位角色都有<b class="gray-text">无限的</b
        >可能性 在这个时代的浪潮中 我们将为你带来最具<b class="gray-text"
          >创新性</b
        >的小说宇宙 
      </p>
    </div>
  </div>
</div>

<!-- Projects Section -->
<div id="projects" class="py-16 bg-base-100">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="text-center mb-8 sm:mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold mb-2 sm:mb-4 mt-16 sm:mt-25">
    项目<br /><small class="text-base-content/80 text-base sm:text-lg">Projects</small>
  </h2>
    </div>
    <!-- 根据项目数量自动居中：1 个居中，2 个并排居中 -->
    <div class="flex flex-wrap justify-center gap-6">
      <% if (Array.isArray(theme['project-card'])) { %>
        <% theme['project-card'].forEach(project => { %>
          <div class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow duration-300
                      <% if (theme['project-card'].length === 1) { %>mx-auto<% } %>
                      <% if (theme['project-card'].length === 2) { %>w-full max-w-md md:w-5/12<% } %>
                      <% if (theme['project-card'].length >= 3) { %>w-full max-w-sm<% } %>">
            <figure class="flex items-center justify-center px-4 sm:px-0">
              <% if (project.image) { %>
                <img data-src="<%= project.image %>" alt="<%= project.title %>" class="lazyload w-full sm:w-96 h-auto object-cover" />
              <% } %>
            </figure>
            <div class="card-body text-center flex flex-col items-center px-4 sm:px-6">
              <div class="w-full sm:w-96">
                <h2 class="card-title text-xl sm:text-2xl justify-center font-semibold mb-3">
                  <%= project.title %>
                  <% if (project.status) { %>
                    <div class="badge badge-neutral text-xs sm:text-sm text-center"><%= project.status %></div>
                  <% } %>
                </h2>
                <p class="text-center text-sm sm:text-base mb-4 leading-relaxed text-base-content/70"><%= project.description || 'No description available.' %></p>
                <div class="card-actions justify-center">
                  <% if (project.url) { %>
                    <a class="btn btn-neutral btn-sm sm:btn-md" href="<%= project.url %>">查看详情</a>
                  <% } else { %>
                    <span class="btn btn-disabled btn-sm sm:btn-md">敬请期待</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-center w-full text-base-content/60">暂无内容</p>
      <% } %>
    </div>
  </div>

<!-- 代表作 -->
<div class="container mx-auto px-4 py-8 text-center" id="products">
  <h2 class="text-3xl sm:text-4xl font-bold mb-2 sm:mb-4 mt-16 sm:mt-25">
    产品<br /><small class="text-base-content/80 text-base sm:text-lg">Products</small>
  </h2>
  <!-- 根据作品数量自动居中：1 个居中，2 个并排居中 -->
  <div class="flex flex-wrap justify-center gap-6">
    <% if (Array.isArray(theme['products'])) { %>
      <% theme['products'].forEach(function(product) { %>
        <div class="card bg-base-100 shadow-xl hover:shadow-2xl
                    <% if (theme['products'].length === 1) { %>w-full max-w-2xl mx-auto<% } %>
                    <% if (theme['products'].length === 2) { %>w-full max-w-md<% } %>
                    <% if (theme['products'].length >= 3) { %>w-full max-w-sm<% } %>">
          <figure class="flex items-center justify-center px-4 sm:px-0">
            <% if (product.image) { %>
              <img data-src="<%= product.image %>" alt="<%= product.title %>" class="lazyload w-full sm:w-96 h-auto object-cover" />
            <% } %>
          </figure>
          <div class="card-body text-center flex flex-col items-center px-4 sm:px-6">
            <div class="w-full sm:w-96">
              <h2 class="card-title text-xl sm:text-2xl justify-center font-semibold mb-3">
                <%= product.title %>
              </h2>
              <p class="text-base-content/70 text-center text-sm sm:text-base mb-4 leading-relaxed"><%= product.description || '暂无简介' %></p>
              <div class="card-actions justify-center mt-4">
                <% if (product.url) { %>
                  <a class="btn btn-neutral btn-sm sm:btn-md" href="<%= product.url %>">立即查看</a>
                <% } else { %>
                  <span class="btn btn-disabled btn-sm sm:btn-md">敬请期待</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center w-full text-base-content/60">暂无内容</p>
    <% } %>
  </div>
</div>

<!-- 音乐专辑 -->
<div class="container mx-auto px-4 py-8 text-center" id="albums">
  <h2 class="text-3xl sm:text-4xl font-bold mb-2 sm:mb-4 mt-16 sm:mt-25">
    音乐专辑<br /><small class="text-base-content/80 text-base sm:text-lg">Music Albums</small>
  </h2>
  <div class="flex flex-wrap justify-center gap-4">
    <% if (Array.isArray(theme['albums'])) { %>
      <% theme['albums'].forEach(function(album) { %>
        <div class="card w-84 transition-shadow duration-300
                    <% if (theme['albums'].length === 1) { %>mx-auto<% } %>
                    <% if (theme['albums'].length === 2) { %>w-full max-w-md md:w-5/12<% } %>
                    <% if (theme['albums'].length >= 3) { %>w-full max-w-sm<% } %>">
          <figure class="flex items-center justify-center px-4 sm:px-6">
            <% if (album.image) { %>
              <img data-src="<%= album.image %>" alt="<%= album.title %> - 专辑封面" class="lazyload w-56 sm:w-72 h-auto object-cover" />
            <% } %>
          </figure>
          <div class="card-body p-4 sm:p-6 text-center">
            <h2 class="card-title text-xl sm:text-2xl justify-center font-semibold mb-3">
              <%= album.title %>
            </h2>
            <p class="text-base-content/70 mb-4 text-sm sm:text-base leading-relaxed"><%= album.description || '暂无简介' %></p>
            <div class="card-actions justify-center">
              <% if (album.url) { %>
                <a class="btn btn-neutral px-4 sm:px-6 btn-sm sm:btn-md" href="<%= album.url %>">立即收听</a>
              <% } else { %>
                <span class="btn btn-disabled px-4 sm:px-6 btn-sm sm:btn-md">敬请期待</span>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center w-full text-base-content/60">暂无内容</p>
    <% } %>
  </div>
</div>

<!-- 短片 -->
<div class="container mx-auto px-4 py-8 text-center" id="short-videos">
  <h2 class="text-3xl sm:text-4xl font-bold mb-2 sm:mb-4 mt-16 sm:mt-25">
    短片<br /><small class="text-base-content/80 text-base sm:text-lg">Short Videos</small>
  </h2>
  <div class="flex flex-wrap justify-center gap-4">
    <% if (Array.isArray(theme['short-videos']) && theme['short-videos'].length) { %>
      <% theme['short-videos'].forEach(function(video) { %>
        <div class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow duration-300
                    <% if (theme['short-videos'].length === 1) { %>mx-auto<% } %>
                    <% if (theme['short-videos'].length === 2) { %>w-full max-w-md md:w-5/12<% } %>
                    <% if (theme['short-videos'].length >= 3) { %>w-full max-w-sm<% } %>">
          <figure class="flex items-center justify-center px-4 sm:px-0">
            <% if (video.image) { %>
              <img data-src="<%= video.image %>" alt="<%= video.title %> 封面" class="lazyload w-full sm:w-96 h-auto object-cover" />
            <% } %>
          </figure>
          <div class="card-body text-center flex flex-col items-center px-4 sm:px-6">
            <div class="w-full sm:w-96">
              <h2 class="card-title text-xl sm:text-2xl justify-center font-semibold mb-3">
                <%= video.title %>
              </h2>
              <p class="text-center text-sm sm:text-base mb-4 leading-relaxed text-base-content/70"><%= video.description || '暂无简介' %></p>
              <div class="card-actions justify-center flex-wrap gap-2">
                <% if (video.type === 'preview') { %>
                  <span class="btn btn-disabled btn-sm sm:btn-md">即将上线</span>
                <% } else if (video.url) { %>
                  <a class="btn btn-neutral btn-sm sm:btn-md" href="<%= video.url %>">立即观看</a>
                <% } %>
                <% if (video.projecturl) { %>
                  <a class="btn bg-white text-black btn-sm sm:btn-md" href="<%= video.projecturl %>">短片介绍</a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center w-full">暂无短片。</p>
    <% } %>
  </div>
</div>

<!-- 团队成员 -->
<div class="container mx-auto px-4 py-8 text-center" id="team-members">
  <h2 class="text-3xl sm:text-4xl font-bold mb-2 sm:mb-4 mt-16 sm:mt-25">
    团队成员<br /><small class="text-base-content/80 text-base sm:text-lg">Team Members</small>
  </h2>
  <div class="flex flex-wrap justify-center gap-4">
    <% if (Array.isArray(theme['team-members'])) { %>
      <% theme['team-members'].forEach(function(member) { %>
        <div class="card bg-base-100 shadow-md hover:shadow-lg transition-shadow duration-300
                    <% if (theme['team-members'].length === 1) { %>mx-auto<% } %>
                    <% if (theme['team-members'].length === 2) { %>w-full max-w-md md:w-5/12<% } %>
                    <% if (theme['team-members'].length >= 3) { %>w-full max-w-sm<% } %>">
          <figure class="px-4 pt-4 sm:px-6 sm:pt-6 flex justify-center">
            <% if (member.avatar) { %>
              <img data-src="<%= member.avatar %>" alt="<%= member.name %> - 团队成员" class="lazyload w-24 h-24 sm:w-32 sm:h-32 object-cover rounded-full" />
            <% } %>
          </figure>
          <div class="card-body text-center p-4 sm:p-6">
            <h2 class="card-title text-lg sm:text-xl justify-center flex-col sm:flex-row font-semibold mb-3">
              <%= member.name %>
              <% if (member.position) { %>
                <div class="badge badge-neutral text-xs sm:text-sm text-center mt-1 sm:mt-0"><%= member.position %></div>
              <% } %>
            </h2>
            <p class="text-center text-sm sm:text-base leading-relaxed text-base-content/70"><%= member.description || '暂无简介' %></p>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p class="text-center w-full">暂无团队成员。</p>
    <% } %>
  </div>
</div>
