<div class="flex-grow bg-base-100">
  <div class="hero hero-animated bg-base-200 min-h-screen">
    <div class="hero-content">
      <div class="justnothingbutifwedonthavethisitwillbroke">
        <h1 class="text-8xl font-bold hero-title">
          每个宇宙<br />拥有无限可能
        </h1>
        <p class="py-6 text-2xl">
          我们正在创造一个个<b class="gray-text">全新的</b
          >，富有创意的小说宇宙，每一位角色都有<b class="gray-text">无限的</b
          >可能性。在这个时代的浪潮中，我们将为你带来最具<b class="gray-text"
            >创新性</b
          >的小说宇宙。
        </p>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8">
    <h2 class="text-4xl font-bold mb-4">
      项目<br /><small class="text-base-content/30">Projects</small>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% if (Array.isArray(theme['project-card'])) { %> <%
      theme['project-card'].forEach(project => { %>
      <div class="card bg-base-100 shadow-lg">
        <figure>
          <% if (project.image) { %>
          <img
            data-src="<%= project.image %>"
            alt="<%= project.title %>"
            class="lazyload"
          />
          <% } %>
        </figure>
        <div class="card-body">
          <h2 class="card-title text-2xl">
            <%= project.title %> <% if (project.status) { %>
            <div class="badge badge-neutral w-22 text-center">
              <%= project.status %>
            </div>
            <% } %>
          </h2>
          <p><%= project.description || 'No description available.' %></p>
          <div class="card-actions justify-end">
            <% if (project.url) { %>
            <a class="btn btn-neutral" href="<%= project.url %>">查看详情</a>
            <% } else { %>
            <span class="btn btn-disabled">敬请期待</span>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %> <% } else { %>
      <p>No projects available.</p>
      <% } %>
    </div>
  </div>

<div class="container mx-auto px-4 py-8">
  <h2 class="text-4xl font-bold mb-4 mt-25">
    代表作<br /><small class="text-base-content/30">Masterpieces</small>
  </h2>
  <!-- 添加 justify-items-center 类使卡片水平居中 -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 justify-items-center">
    <% if (Array.isArray(theme['works'])) { %> <%
    theme['works'].forEach(function(work) { %>
    <div class="card shadow-xl w-80 px-2 py-3 flex mt-4 flex-col justify-between items-center">
      <span class="overflow-hidden m-2 flex items-center">
        <img
          src="<%= work.image %>"
          alt="海报"
          class="rounded-md mx-auto items-center"
          style="
            height: 300px;
          "
        />
      </span>
      <div class="mt-3 flex flex-col items-center text-center">
        <div class="flex flex-col items-center">
          <h3 class="text-2xl font-bold"><%= work.title %></h3>
        </div>
        <p class="mt-2 px-2 text-base-content/50"><%= work.description %></p>
      </div>
      <a
        href="<%= work.url %>"
        class="btn btn-neutral btn-wide text-lg mt-2 mb-2"
        >立即阅读</a>
    </div>
    <% }); %> <% } else { %>
    <p class="text-center">暂无作品。</p>
    <% } %>
  </div>
</div>

  <div class="container mx-auto px-4 py-8">
    <h2 class="text-4xl font-bold mb-4 mt-25">音乐专辑<br /><small class="text-base-content/30">Music Albums</small></h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 justify-items-center">
      <% if (Array.isArray(theme['albums'])) { %> <%
      theme['albums'].forEach(function(album) { %>
      <div class="card shadow-xl w-80 p-2 flex mt-4 flex-col items-center justify-between"> <!-- 添加 justify-between 使内容分布在卡片两端 -->
        <span class="overflow-hidden m-2 flex items-center">
          <img
            src="<%= album.image %>"
            alt="专辑封面"
            class="rounded-md mx-auto items-center"
            style="width: 300px; height: 300px; object-fit: cover;"
          />
        </span>
        <div class="mt-2 flex flex-col items-center text-center w-full">
          <div class="flex items-start justify-center w-full">
            <div class="flex-grow text-center">
              <h3 class="text-xl font-bold"><%= album.title %></h3>
            </div>
          </div>
          <!-- 修正拼写错误 text-base-conntent 为 text-base-content -->
          <p class="mt-2 text-base-content/70"><%= album.publish %></p>
          <p class="mt-2 text-base-content/50 px-2"><%= album.description %></p>
        </div>
        <a
          href="<%= album.url %>"
          class="btn btn-neutral btn-wide text-lg mt-2 mx-auto mb-2">立即收听</a>
      </div>
      <% }); %> <% } else { %>
      <p class="text-center">暂无作品。</p>
      <% } %>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8">
    <h2 class="text-4xl font-bold mb-4 mt-25">
      团队成员<br /><small class="text-base-content/30">Team Members</small>
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
      <% if (Array.isArray(theme['team-members'])) { %> <%
      theme['team-members'].forEach(member => { %>
      <div class="team-member">
        <img
          data-src="<%= member.avatar %>"
          alt="<%= member.name %>"
          class="rounded-md shadow-xl mb-6 object-cover lazyload"
          style="width: 168px; height: 168px"
        />
        <span class="text-2xl"><%= member.name %></span>
        <p class="text-base-content/30"><%= member.description %></p>
      </div>
      <% }); %> <% } %>
    </div>
  </div>

  <div class="container mx-auto px-4 py-8">
    <h2 class="text-4xl font-bold mb-4 mt-25">
      关于<br /><small class="text-base-content/30">About</small>
    </h2>
    <div
      tabindex="0"
      class="collapse collapse-arrow bg-base-100 border-base-300 border mb-4"
    >
      <div class="collapse-title font-semibold">我们是谁？</div>
      <div class="collapse-content text-sm">
        我们是火石，是一个制作概念性宇宙以及概念内容的团队。我们致力于创造庞大的宇宙观和丰富的角色设定，让读者身临其境地感受到每个角色的故事和情感。
      </div>
    </div>

    <div
      tabindex="0"
      class="collapse collapse-arrow bg-base-100 border-base-300 border"
    >
      <div class="collapse-title font-semibold">火石为什么而生？</div>
      <div class="collapse-content text-sm">
        火石为创作而生。我们的目标是为读者带来一个充满无限可能性的世界，让读者能够在这个世界中自由地探索和发现。
      </div>
    </div>
  </div>
</div>
<div class="flex justify-center items-center mb-5">
  <button
    class="btn btn-neutral btn-wide text-center hover:scale-105 transition-transform duration-300"
    onclick="subscribe.showModal()"
  >
    订阅新闻 <img src="..\image\icons\campaign_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.svg" alt="Subscribe Icon">
  </button>
</div>

