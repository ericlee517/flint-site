---
import { footer } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="brand">
          <img src={footer.brand.logo} alt="" width="34" height="34" loading="lazy" decoding="async" />
          <span>{footer.brand.name}</span>
        </div>
        <p>{footer.brand.slogan}</p>
      </div>
      <div>
        <h4>友情链接</h4>
        <ul class="footer-links">
          {footer.links.map((item) => (
            <li><a href={item.url} rel="noopener">{item.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>文档</h4>
        <ul class="footer-links">
          {footer.document.map((item) => (
            <li><a href={item.url} rel="noopener">{item.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>联系</h4>
        <ul class="footer-links">
          {footer.contact.map((item) => (
            <li><a href={item.url} rel="noopener">{item.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="slogan">{footer.bottomSlogan}</p>
      <p class="copyright">© {year} {footer.copyright}</p>
    </div>
  </div>
</footer>
