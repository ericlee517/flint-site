---
interface Props {
  title: string;
  description?: string;
  date: Date;
  categories: string[];
  cover?: string;
  slug: string;
}

const { title, description = '', date, categories, slug } = Astro.props;

const formatDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<article class="card post-card" data-reveal>
  <div class="meta">
    <span class="cat">{categories[0] ?? '未分类'}</span>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>
  <h3><a href={`/post/${slug}`}>{title}</a></h3>
  {description && <p class="excerpt">{description}</p>}
  <a class="link" href={`/post/${slug}`}>
    阅读全文
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </svg>
  </a>
</article>
