---
import Layout from '../layouts/Layout.astro';
---

<Layout title="微信公众号" description="涡轮火石微信公众号停运通知">
  <main id="main">
    <div class="page-hero">
      <h1><span class="gradient-text">微信公众号</span></h1>
    </div>
    <section class="section section--top-tight">
      <div class="container">
        <div class="prose-page prose-page--center">
          <img
            src="/image/wechat_qrcode.jpg"
            alt="微信公众号二维码"
            width="220"
            height="220"
            loading="lazy"
            decoding="async"
            class="qrcode"
          />
          <h2>公众号已停止运营</h2>
          <p>由于微信公众平台的运营成本与平台策略调整，涡轮火石微信公众号已停止运营。感谢您一直以来的关注与支持，我们将在其他平台继续创作与分享。</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
